{
  "name": "scavio",
  "version": "0.15.0",
  "description": "TypeScript SDK for the Scavio API — real-time web scraping and data extraction across 31 platforms on one API key: Google SERP, Amazon, Walmart, eBay, Zillow, Redfin, Booking, Airbnb, Yelp, Indeed, Glassdoor, G2, App Store, Google Play, SEC EDGAR, Google Ads and Meta Ad Library, YouTube, TikTok, Instagram, X, LinkedIn, Reddit and more, plus extract() to read any URL as clean Markdown",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "web-scraping",
    "scraping-api",
    "data-extraction",
    "url-to-markdown",
    "web-search",
    "search-api",
    "serp-api",
    "google-search",
    "ai-agents",
    "amazon-scraper",
    "walmart-api",
    "ebay-api",
    "product-data",
    "zillow-api",
    "real-estate-data",
    "indeed-api",
    "jobs-api",
    "glassdoor",
    "yelp-api",
    "reviews-api",
    "g2",
    "app-store-scraper",
    "google-play-scraper",
    "sec-edgar",
    "company-data",
    "ad-library",
    "youtube-api",
    "tiktok-api",
    "instagram-api",
    "linkedin-api",
    "reddit-api",
    "twitter-api",
    "threads-api",
    "social-media-data",
    "serpapi-alternative",
    "tavily-alternative",
    "firecrawl-alternative"
  ],
  "license": "MIT",
  "author": "Scavio <support@scavio.dev>",
  "homepage": "https://scavio.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/scavio-ai/scavio-js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
